---
import ExprienceItem from "./ExprienceItem.astro";
const EXPERIENCE = [
  {
    date: "Enero 2023 - Presente",
    title: "Full-stack Developer Senior — Grupo Ecoquintas",
    company: "Grupo Ecoquintas",
    description:
      "Lidero el ecosistema digital multiplataforma utilizando React, Next.js y Node.js. Arquitecto de APIs críticas para la verificación de clientes y responsable del despliegue exitoso de aplicaciones móviles nativas en la Play Store, escalando soluciones para miles de usuarios.",
    link: "https://play.google.com/store/apps/details?id=com.grupoecoquintas.EcoApp",
  },
  {
    date: "Mayo 2022 - Octubre 2022",
    title: "Web User Interface Developer — Globant",
    company: "Globant",
    description:
      "Desarrollé interfaces de alto rendimiento para gigantes de la industria como Disney y Royal Caribbean. Implementé arquitecturas escalables con React y aseguré la integridad del producto mediante sistemas de testing robustos con Jest, cumpliendo con los estándares de calidad más exigentes del mercado global.",
  },
  {
    date: "Enero 2022 - Mayo 2022",
    title: "Software Engineer — Nayara Resorts",
    company: "Nayara Resorts",
    description:
      "Diseñé y desarrollé experiencias digitales de lujo para uno de los resorts más prestigiosos del mundo. Utilicé Vue.js y Vuetify para crear interfaces inmersivas y fluidas que reflejan la exclusividad de la marca, optimizando la interacción del usuario en entornos de altísima demanda visual.",
  },
];
---

<ol class="relative border-s border-white/10 ml-6 space-y-2">
  {
    EXPERIENCE.map((experiencia) => (
      <li class="group">
        <ExprienceItem {...experiencia} />
      </li>
    ))
  }
</ol>
