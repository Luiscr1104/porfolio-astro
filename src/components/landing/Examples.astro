---

---

<section class="py-24 bg-slate-50 relative overflow-hidden" id="ejemplos">
    <div class="max-w-screen-xl mx-auto px-4 relative z-10">
        <div class="text-center mb-16">
            <h2 class="text-3xl lg:text-5xl font-bold text-slate-900">
                Trabajos Reales
            </h2>
            <p class="text-lg text-slate-500 mt-4">
                Calidad que vende por sí sola.
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            <!-- Example 1: JyM Mantenimientos -->
            <a
                href="https://jym-mantenimientos.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="group block"
            >
                <div
                    class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 border border-slate-100 relative aspect-[4/3]"
                >
                    <div
                        class="absolute inset-0 bg-slate-200 animate-pulse z-0"
                    >
                    </div>
                    <!-- Loading Skeleton -->
                    <img
                        src="/projects/jym.png"
                        alt="JyM Mantenimientos Website"
                        class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105 relative z-10"
                        loading="lazy"
                    />
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20 flex items-end p-6"
                    >
                        <span
                            class="text-white font-medium flex items-center gap-2"
                        >
                            Ver sitio en vivo <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                ></path></svg
                            >
                        </span>
                    </div>
                </div>
                <div class="mt-5 pl-2">
                    <h3
                        class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors"
                    >
                        JyM Mantenimientos
                    </h3>
                    <p class="text-slate-500 text-sm mt-1">
                        Mantenimiento de piscinas
                    </p>
                </div>
            </a>

            <!-- Example 2: Buy Land CR -->
            <a
                href="https://buylandcr.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="group block"
            >
                <div
                    class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 border border-slate-100 relative aspect-[4/3]"
                >
                    <div
                        class="absolute inset-0 bg-slate-200 animate-pulse z-0"
                    >
                    </div>
                    <img
                        src="/projects/buylandcr.png"
                        alt="Buy Land CR Website"
                        class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105 relative z-10"
                        loading="lazy"
                    />
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20 flex items-end p-6"
                    >
                        <span
                            class="text-white font-medium flex items-center gap-2"
                        >
                            Ver sitio en vivo <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                ></path></svg
                            >
                        </span>
                    </div>
                </div>
                <div class="mt-5 pl-2">
                    <h3
                        class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors"
                    >
                        Buy Land CR
                    </h3>
                    <p class="text-slate-500 text-sm mt-1">Bienes Raíces</p>
                </div>
            </a>

            <!-- Example 3: Pure Oxygen -->
            <a
                href="https://pure-oxygen.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="group block"
            >
                <div
                    class="rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 border border-slate-100 relative aspect-[4/3]"
                >
                    <div
                        class="absolute inset-0 bg-slate-200 animate-pulse z-0"
                    >
                    </div>
                    <img
                        src="/projects/pureOxygen.png"
                        alt="Pure Oxygen Website"
                        class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105 relative z-10"
                        loading="lazy"
                    />
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20 flex items-end p-6"
                    >
                        <span
                            class="text-white font-medium flex items-center gap-2"
                        >
                            Ver sitio en vivo <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                ></path></svg
                            >
                        </span>
                    </div>
                </div>
                <div class="mt-5 pl-2">
                    <h3
                        class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors"
                    >
                        Pure Oxygen
                    </h3>
                    <p class="text-slate-500 text-sm mt-1">Airbnb de Lujo</p>
                </div>
            </a>
        </div>
    </div>
</section>
