---

<section
    class="py-24 md:py-32 bg-slate-900 px-4 text-center relative overflow-hidden"
>
    <!-- Background Effects -->
    <div
        class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none"
    >
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/20 rounded-full blur-[100px]"
        >
        </div>
    </div>

    <div class="max-w-4xl mx-auto relative z-10 space-y-8">
        <h2
            class="text-4xl md:text-5xl lg:text-7xl font-bold text-white tracking-tight"
        >
            ¿Empezamos hoy?
        </h2>
        <p
            class="text-xl md:text-2xl text-slate-300 max-w-2xl mx-auto font-light"
        >
            No deje pasar más clientes. Escríbame y le asesoro sin compromiso.
        </p>

        <div class="pt-8">
            <a
                href="https://wa.me/50684291847?text=Hola%20Luis,%20quiero%20que%20empecemos%20a%20trabajar%20en%20mi%20sitio%20web"
                target="_blank"
                class="inline-flex items-center justify-center gap-3 bg-green-500 hover:bg-green-400 text-white font-bold py-5 px-10 rounded-full text-xl transition-all hover:scale-105 shadow-[0_0_40px_-10px_rgba(74,222,128,0.5)]"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-7 h-7"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                    <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path>
                    <path
                        d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
                    ></path>
                </svg>
                Hablar con Luis
            </a>
        </div>

        <div
            class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-slate-500 text-sm"
        >
            <p>© {new Date().getFullYear()} Luis Zúñiga. Costa Rica 🇨🇷</p>
            <div class="flex gap-4 items-center">
                <a
                    href="mailto:luiscr1104@gmail.com"
                    class="hover:text-white transition-colors"
                    >luiscr1104@gmail.com</a
                >
                <span class="w-1 h-1 bg-slate-700 rounded-full"></span>
                <span>Privacidad</span>
            </div>
        </div>
    </div>
</section>
