                    <li class="flex items-start gap-3">
                        <div
                            class="mt-1 w-5 h-5 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-3 h-3 text-green-600"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path></svg
