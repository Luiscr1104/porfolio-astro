---

---

<section
    class="py-12 border-y border-slate-100/50 bg-white/50 backdrop-blur-sm"
>
    <div class="max-w-screen-xl mx-auto px-4">
        <p
            class="text-center text-slate-500 mb-8 text-sm font-medium uppercase tracking-widest"
        >
            Perfecto para negocios locales
        </p>

        <div
            class="flex flex-wrap justify-center gap-8 md:gap-16 opacity-75 grayscale hover:grayscale-0 transition-all duration-500"
        >
            <div class="flex flex-col items-center gap-2 group">
                <div
                    class="p-3 bg-blue-50 text-blue-600 rounded-xl group-hover:scale-110 transition-transform"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-6 h-6"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4"
                        ></path><path d="M13.5 6.5l4 4"></path></svg
                    >
                </div>
                <span class="font-medium text-slate-600">Barberías</span>
            </div>

            <div class="flex flex-col items-center gap-2 group">
                <div
                    class="p-3 bg-orange-50 text-orange-600 rounded-xl group-hover:scale-110 transition-transform"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-6 h-6"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5"
                        ></path></svg
                    >
                </div>
                <span class="font-medium text-slate-600">Talleres</span>
            </div>

            <div class="flex flex-col items-center gap-2 group">
                <div
                    class="p-3 bg-green-50 text-green-600 rounded-xl group-hover:scale-110 transition-transform"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-6 h-6"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path d="M3 21v-13l9 -4l9 4v13"></path><path
                            d="M13 13h4v8h-10v-6h6"></path><path
                            d="M13 21v-9a1 1 0 0 0 -1 -1h-2a1 1 0 0 0 -1 1v3"
                        ></path></svg
                    >
                </div>
                <span class="font-medium text-slate-600">Airbnb</span>
            </div>

            <div class="flex flex-col items-center gap-2 group">
                <div
                    class="p-3 bg-cyan-50 text-cyan-600 rounded-xl group-hover:scale-110 transition-transform"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-6 h-6"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M2 20a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1a2.4 2.4 0 0 1 2 -1a2.4 2.4 0 0 1 2 1a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1a2.4 2.4 0 0 1 2 -1a2.4 2.4 0 0 1 2 1a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1"
                        ></path><path
                            d="M2 17a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1a2.4 2.4 0 0 1 2 -1a2.4 2.4 0 0 1 2 1a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1a2.4 2.4 0 0 1 2 -1a2.4 2.4 0 0 1 2 1a2.4 2.4 0 0 0 2 1a2.4 2.4 0 0 0 2 -1"
                        ></path><path d="M9 12v-8h-3a3 3 0 0 0 -3 3v5"
                        ></path><path d="M6 8l-2 2"></path><path d="M6 9l-2 2"
                        ></path></svg
                    >
                </div>
                <span class="font-medium text-slate-600">Piscinas</span>
            </div>

            <div class="flex flex-col items-center gap-2 group">
                <div
                    class="p-3 bg-purple-50 text-purple-600 rounded-xl group-hover:scale-110 transition-transform"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-6 h-6"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5"
                        ></path><path d="M12 12l8 -4.5"></path><path
                            d="M12 12l0 9"></path><path d="M12 12l-8 -4.5"
                        ></path></svg
                    >
                </div>
                <span class="font-medium text-slate-600">PYMES</span>
            </div>
        </div>
    </div>
</section>
