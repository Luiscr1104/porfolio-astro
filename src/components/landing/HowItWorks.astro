---

---

<section class="py-20 md:py-32 bg-slate-50 relative overflow-hidden">
    <!-- Modern grid background -->
    <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"
    >
    </div>

    <div class="max-w-screen-xl mx-auto px-4 relative z-10">
        <div class="text-center mb-20">
            <span
                class="text-blue-600 font-bold tracking-wider uppercase text-sm"
                >Proceso Simple</span
            >
            <h2 class="text-3xl lg:text-5xl font-bold text-slate-900 mt-2">
                ¿Cómo funciona?
            </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-12 text-center relative">
            <!-- Decorator line for desktop -->
            <div
                class="hidden md:block absolute top-[2.5rem] left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-blue-200 to-transparent -z-10 bg-opacity-50 border-t border-dashed border-blue-300"
            >
            </div>

            <!-- Step 1 -->
            <div class="relative group">
                <div
                    class="w-20 h-20 bg-white rounded-2xl flex items-center justify-center text-3xl font-bold mx-auto mb-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 group-hover:scale-110 group-hover:shadow-[0_8px_30px_rgb(37,99,235,0.15)] transition-all duration-300 z-10 relative"
                >
                    <span class="text-blue-600">1</span>
                </div>
                <h3
                    class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors"
                >
                    Hacemos su página
                </h3>
                <p class="text-slate-600 px-4 leading-relaxed">
                    Diseño moderno con su información, fotos y precios. Todo
                    listo para causar buena impresión.
                </p>
            </div>

            <!-- Step 2 -->
            <div class="relative group">
                <div
                    class="w-20 h-20 bg-white rounded-2xl flex items-center justify-center text-3xl font-bold mx-auto mb-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 group-hover:scale-110 group-hover:shadow-[0_8px_30px_rgb(37,99,235,0.15)] transition-all duration-300 z-10 relative"
                >
                    <span class="text-blue-600">2</span>
                </div>
                <h3
                    class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors"
                >
                    El cliente ve y decide
                </h3>
                <p class="text-slate-600 px-4 leading-relaxed">
                    Entran a su página desde el celular, ven lo que ofrece y se
                    convencen rápido.
                </p>
            </div>

            <!-- Step 3 -->
            <div class="relative group">
                <div
                    class="w-20 h-20 bg-gradient-to-br from-green-500 to-emerald-600 text-white rounded-2xl flex items-center justify-center text-3xl font-bold mx-auto mb-8 shadow-[0_8px_30px_rgb(34,197,94,0.3)] group-hover:scale-110 transition-all duration-300 z-10 relative"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-10 h-10"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                        ></path><path
                            d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"
                        ></path><path
                            d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
                        ></path></svg
                    >
                </div>
                <h3
                    class="text-xl font-bold text-slate-900 mb-3 group-hover:text-green-600 transition-colors"
                >
                    Le escriben para comprar
                </h3>
                <p class="text-slate-600 px-4 leading-relaxed">
                    Un clic en el botón y recibe el mensaje en su WhatsApp listo
                    para cerrar la venta.
                </p>
            </div>
        </div>
    </div>
</section>
