---
const currentYear = new Date().getFullYear();
---

<footer
  class="opacity-90 mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center px-4"
>
  <div
    class="w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-between py-4 border-t border-white/10"
  >
    <span class="text-sm sm:text-center text-zinc-300"
      >© {currentYear}
      <a
        href="https://luisroberto.dev/"
        class="hover:underline text-white font-medium">luisroberto.dev</a
      >. Hecho con ❤️ desde Costa Rica.
    </span>
    <ul
      class="flex flex-wrap items-center mt-3 text-sm font-medium text-zinc-300 sm:mt-0"
    >
      <li>
        <a
          href="/#sobre-mi"
          class="hover:text-white transition-colors me-4 md:me-6">Sobre mí</a
        >
      </li>
      <li>
        <a
          id="contacto"
          href="mailto:luiscr1104@gmail.com"
          class="hover:text-white transition-colors">Contacto</a
        >
      </li>
    </ul>
  </div>
</footer>
