---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import Linkedin from "../components/icons/Linkedin.astro";
import SocialPill from "../components/SocialPill.astro";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import MailIcon from "../components/icons/MailIcon.astro";
import Experience from "../components/Experience.astro";
import SectionContainer from "../components/SectionContainer.astro";
import ExperienceIcon from "../components/icons/ExperienceIcon.astro";
import CodeIcon from "../components/icons/Code.astro";
import Projects from "../components/Projects.astro";
---

<style is:global>
  .snap-start {
    scroll-snap-align: start;
  }
</style>

<Layout
  title="Porfolio de Luis R Zúñiga S - Desarrollador y Programador Web con +5 años de experiencia"
  description="Desarrollador y Programador Web con +5 años de experiencia en desarrollo de sitios únicos."
>
  <SectionContainer
    class="py-32 md:py-48 pb-32 min-h-screen flex flex-col justify-center snap-start"
  >
    <div class="flex flex-col gap-6 items-start">
      <div class="flex items-center gap-4">
        <img
          class="rounded-full shadow-2xl size-20 border-2 border-white/10"
          src="/avatar.png"
          alt="luis photo"
        />
        <Badge>Disponible para trabajar</Badge>
      </div>

      <h1
        class="text-5xl md:text-7xl font-bold tracking-tighter text-white lg:max-w-4xl"
      >
        Diseñando el <span
          class="bg-gradient-to-r from-yellow-200 via-yellow-400 to-yellow-200 bg-clip-text text-transparent"
          >futuro digital</span
        > desde Costa Rica.
      </h1>

      <p class="text-xl md:text-2xl text-gray-400 max-w-2xl leading-relaxed">
        Soy Luis Roberto, un desarrollador con <span
          class="text-white font-medium">+5 años de experiencia</span
        > que transforma ideas complejas en experiencias web excepcionales.
      </p>

      <nav class="flex flex-wrap gap-4 mt-4">
        <SocialPill
          href="https://www.linkedin.com/in/luis-z%C3%BA%C3%B1iga-s%C3%A1nchez-812017190/"
        >
          <Linkedin class="size-5" />
          LinkedIn
        </SocialPill>
        <SocialPill href="https://github.com/Luiscr1104">
          <GitHubIcon class="size-5" />
          GitHub
        </SocialPill>
        <SocialPill href="mailto:luiscr1104@gmail.com">
          <MailIcon class="size-5" />
          Escríbeme
        </SocialPill>
      </nav>
    </div>
  </SectionContainer>

  <SectionContainer
    id="experiencia"
    class="min-h-screen flex flex-col justify-center snap-start"
  >
    <h2
      class="text-white text-3xl font-semibold mb-6 flex gap-x-3 items-center"
    >
      <ExperienceIcon class="size-7" /> Experiencia Laboral
    </h2>
    <Experience />
  </SectionContainer>

  <SectionContainer id="proyectos">
    <h2
      class="text-white text-3xl font-semibold mb-6 flex gap-x-3 items-center"
    >
      <CodeIcon class="size-7" /> Proyectos
    </h2>
    <Projects />
  </SectionContainer>
</Layout>
